# 백엔드(Spring Boot) API 기본 URL.
# - 로컬: 아래처럼 localhost:8080 직접 지정.
# - 배포(Cloudflare Pages): 이 값을 "비워두거나 미설정"으로 둘 것. 그러면 프론트가
#   상대경로 /api/... 로 요청하고, 같은 오리진의 Pages Function(functions/api)이
#   백엔드(Render)로 리버스 프록시해 세션/CSRF 쿠키가 1st-party가 된다.
#   (백엔드 주소는 Cloudflare Pages 환경변수 BACKEND_URL로 주입 — functions/api 참고)
VITE_API_BASE_URL=http://localhost:8080

# Kakao Map JavaScript SDK 앱 키 (Kakao Developers > 내 애플리케이션 > JavaScript 키)
VITE_KAKAO_MAP_APP_KEY=ec8225ff9325d606befacdaa92ad3177
