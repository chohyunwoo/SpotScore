# Local dev DB (docker-compose.yml) - defaults already match application-dev.yml,
# override only if you need different local credentials.
POSTGRES_DB=spotscore
POSTGRES_USER=spotscore
POSTGRES_PASSWORD=spotscore

# SGIS (통계청 통계지리정보서비스) - https://sgis.kostat.go.kr 에서 발급
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 소상공인시장진흥공단 상가(상권)정보 - https://www.data.go.kr 에서 발급
STORE_ZONE_SERVICE_KEY=

# KOSIS(통계청 국가통계포털) 연령별 인구 - https://kosis.kr/openapi 에서 발급
KOSIS_API_KEY=

# Groq (창업 상담 챗봇 tool-calling, OpenAI 호환 무료 티어) - https://console.groq.com/keys 에서 발급
# 미설정 시 챗봇만 비활성화되고 나머지 기능은 정상 동작한다.
GROQ_API_KEY=

# /api/v1/admin/** 보호용 공유 API Key - 요청 헤더 X-Admin-Api-Key로 제시해야 함
# (dev 미설정 시 admin 요청 전부 차단, prod는 미설정 시 부팅 실패)
ADMIN_API_KEY=

# prod profile only (Supabase Postgres connection info)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
